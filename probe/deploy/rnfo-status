#!/bin/sh
# Prints this probe's newest controls run record, one JSON line.
#
# This is the whole interface between a watcher and a probe. A watcher's ssh
# key is authorised with command="/opt/rnfo/bin/rnfo-status" and restrict, so
# it can run exactly this and nothing else. Keep it POSIX sh: the same body
# runs under Termux as status.sh.
D=$(for f in /etc/rnfo/probe.env "$HOME/rnfo/probe.env"; do [ -f "$f" ] && grep -m1 "^RNFO_DATA_DIR=" "$f"; done | head -1 | cut -d= -f2)
[ -z "$D" ] && D=/var/lib/rnfo/data
Y=$(date -u -d yesterday +%F 2>/dev/null || date -u -v-1d +%F 2>/dev/null)
T=$(date -u +%F)
for f in "$D/runs/$Y.jsonl" "$D/runs/$T.jsonl"; do
  [ -f "$f" ] && grep '"profile":"controls"' "$f"
done | grep '"kind":"run"' | tail -1
