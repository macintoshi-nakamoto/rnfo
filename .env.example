# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# Collection is pull-based: the collector reaches into probes, probes hold no
# credentials. A probe that is compromised therefore cannot touch the archive.

# Probes the collector pulls from. Format: <probe-id>=<user>@<host>[:port]
# The probe id must match an active entry in probes.yaml.
RNFO_SSH_ru_msk_vps=root@<moscow-vps>
RNFO_SSH_nl_lim_panel=root@<panel-host>
RNFO_SSH_de_fra_vps=root@<frankfurt-vps>
# Handsets are reached through their reverse tunnel; see docs/OPERATIONS.md.
RNFO_SSH_ru_mow_home=rnfo-home

# Optional jump host, if a probe is only reachable through another machine.
# RNFO_SSH_JUMP_ru_mow_home=root@example

# Where the collector writes the archive. Relative paths are resolved against
# the repository root.
RNFO_ARCHIVE=data

# SSH identity used for pulling. Key auth only.
RNFO_SSH_KEY=~/.ssh/id_ed25519

# Where health alerts go. A URL containing {text} is fetched with GET after
# substitution (a Telegram bot's sendMessage works as is); any other URL gets
# a JSON POST {"text": ...}. The bot cannot message you until you have opened
# it and pressed Start once.
# RNFO_ALERT_URL=https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>&text={text}

# Public key of the watcher on the always-on host. The deploy tools authorise
# it on every probe for exactly one command, the status script.
# RNFO_WATCH_PUBKEY=ssh-ed25519 AAAA... rnfo-watch@<host>
